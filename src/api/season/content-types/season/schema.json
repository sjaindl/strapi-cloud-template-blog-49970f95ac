{
  "kind": "collectionType",
  "collectionName": "seasons",
  "info": {
    "singularName": "season",
    "pluralName": "seasons",
    "displayName": "Saison",
    "description": "Meisterschafts-Saison mit Liga und Hinweistexten. Der Schlüssel (z. B. 2026-2027) erscheint in der URL."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^\\d{4}-\\d{4}$"
    },
    "league": {
      "type": "string"
    },
    "preface": {
      "type": "text"
    },
    "postResults": {
      "type": "text"
    },
    "standings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::standing.standing",
      "mappedBy": "season"
    }
  }
}
