{
  "kind": "collectionType",
  "collectionName": "players",
  "info": {
    "singularName": "player",
    "pluralName": "players",
    "displayName": "Spieler",
    "description": "Spieler des HV TDP Stainz. Status: Kader (Team-Seite), Aktiv (weitere aktive Mitglieder), Ehemalig (nur für Torschützen/Voting)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "Tormann",
        "Verteidiger",
        "Mittelfeld",
        "Stürmer"
      ]
    },
    "squad": {
      "type": "enumeration",
      "enum": [
        "Kader",
        "Aktiv",
        "Ehemalig"
      ],
      "default": "Kader",
      "required": true
    },
    "memberSinceYear": {
      "type": "integer"
    },
    "games": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "goals": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "adminTitle": {
      "type": "string",
      "private": true
    }
  }
}
