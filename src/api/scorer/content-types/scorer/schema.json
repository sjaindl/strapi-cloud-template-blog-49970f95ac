{
  "kind": "collectionType",
  "collectionName": "scorers",
  "info": {
    "singularName": "scorer",
    "pluralName": "scorers",
    "displayName": "Torschützenliste",
    "description": "Tore pro Spieler und Saison (inkl. Testspiele), getrennt von den Torschützen der einzelnen Spiele gepflegt."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "season": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::season.season"
    },
    "player": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player"
    },
    "name": {
      "type": "string"
    },
    "goals": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    },
    "adminTitle": {
      "type": "string",
      "private": true
    }
  }
}
